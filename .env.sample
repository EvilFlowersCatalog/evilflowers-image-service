# Every variable is optional; the defaults are in src/evilflowers_image/settings.py and evilflowers-worker's
# settings.py (broker, delivery semantics, storage, catalog API, logs).

REDIS_URL=redis://redis:6379/7
IMAGE_QUEUE=evilflowers_image
# Seconds before Redis redelivers an unacknowledged job. One value for every consumer of the db (12 h).
BROKER_VISIBILITY_TIMEOUT=43200
# Scale-in: seconds a SIGTERMed worker lets the running book go on before it cancels it and Redis requeues it,
# then seconds the cancel may take. Keep the sum below the pod's terminationGracePeriodSeconds. Never set
# REMAP_SIGTERM.
WORKER_SOFT_SHUTDOWN_TIMEOUT=60
WORKER_CANCEL_TIMEOUT=30
# Deliveries of one message before the job is reported failed instead of run again (it killed its worker every
# time); 0 turns the cap off.
MAX_DELIVERIES=5
STORAGE_PATH=/mnt/data

# IP-018 extraction jobs report here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=

# Standalone (books digitalizer): 1 consumes the two queues below instead of IMAGE_QUEUE, with REDIS_URL on the
# digitalizer's db (8 on dev) and no CATALOG_API_*.
IMAGE_STANDALONE=0
STANDALONE_QUEUE=evilflowers_image.standalone
INTERACTIVE_QUEUE=evilflowers_image.standalone.interactive

# Keep/hide (#6). The same image on this many pages of one job is hidden without a model (decision: repeated);
# bits of 64 two perceptual hashes may differ in.
REPEAT_MIN_PAGES=3
REPEAT_MAX_DISTANCE=4
# decider-vision (evilflowers-worker's `judges` extra; knowledge Cookbooks/Deploy-Decision-Models). Off, or empty:
# every figure is posted without a band, as before.
DECIDER_ENABLED=false
DECIDER_VISION_URL=
DECIDER_TIMEOUT=60
# Bands per question, measured in knowledge#65; empty until then (the catalog gets p and decision, no band).
# JUDGE_THRESHOLDS={"figure_kind": {"keep": 0.8, "hide": 0.9}}
JUDGE_THRESHOLDS=
# What one job may spend on judges (0: no limit).
JUDGE_BUDGET_CALLS=500
JUDGE_BUDGET_SECONDS=900
JUDGE_MAX_SIDE=448

# Crops
CROP_DPI=144
WEBP_QUALITY=82

# Gates: smaller than this on a side (px at CROP_DPI), longer than this ratio, or covering more of the page
MIN_SIDE_PX=80
MAX_ASPECT_RATIO=8
MAX_PAGE_COVERAGE=0.9

# Captions by a multimodal model behind Ollama (off on CPU-only hosts; the printed caption is kept either way)
CAPTIONS_ENABLED=0
OLLAMA_ENDPOINT=http://ollama:11434/api/chat
OLLAMA_API_KEY=
CAPTION_MODEL=qwen2.5vl:7b
CAPTION_TIMEOUT=180
CAPTION_MAX_SIDE=1024

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=image
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=image
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=image,cluster=k8s-stu
