# Every variable is optional; the defaults are in src/evilflowers_image/settings.py.

REDIS_URL=redis://redis:6379/7
IMAGE_QUEUE=evilflowers_image
# Seconds before Redis redelivers an unacknowledged job; longer than the longest book.
BROKER_VISIBILITY_TIMEOUT=7200
STORAGE_PATH=/mnt/data

# IP-018 extraction jobs report here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=

# Crops
CROP_DPI=144
WEBP_QUALITY=82

# Gates: smaller than this on a side (px at CROP_DPI), longer than this ratio, or covering more of the page
MIN_SIDE_PX=80
MAX_ASPECT_RATIO=8
MAX_PAGE_COVERAGE=0.9

# Captions by a multimodal model behind Ollama (off on CPU-only hosts; the printed caption is kept either way)
CAPTIONS_ENABLED=0
OLLAMA_ENDPOINT=http://ollama:11434/api/chat
OLLAMA_API_KEY=
CAPTION_MODEL=qwen2.5vl:7b
CAPTION_TIMEOUT=180
CAPTION_MAX_SIDE=1024

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=image
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=image
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=image,cluster=k8s-stu
